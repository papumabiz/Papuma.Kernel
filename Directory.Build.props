<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.0.0-preview.1</Version>
    <Authors>Harald Lapp</Authors>
    <Copyright>Copyright © 2026 Harald Lapp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/papumabiz/Papuma.Kernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/papumabiz/Papuma.Kernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <!-- Source Link: the SDK resolves the GitHub provider automatically; these make the
       published packages debuggable (step into the exact commit) and reproducible. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- XML documentation ships with the packages so consumers get IntelliSense.
       CS1591 (missing comment on a public member) stays off: the public surface is
       documented, but internals promoted to public for testing are not, and a wall of
       CS1591 would drown real warnings. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet audit over direct and transitive packages (review B-3): a known moderate,
       high or critical vulnerability fails the restore; low ones stay warnings. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- The shipped libraries (src/) build with the recommended analyzer set and no warnings
       (review B-9). Tests, samples and benchmarks keep the SDK default. Turned off:
       - CA1848, CA1873: LoggerMessage source generation; the kernel logs on rare paths
         (failures, retries, startup), where the plain ILogger calls cost nothing measurable.
       - CA1859: concrete collection types for a few interface calls; the IReadOnly* types
         state intent, and the calls are not on a hot path.
       - CA1711, CA1716: IEventHandler and its `event` parameter are public API; renaming
         would break every consumer.
       NU1901 (low-severity advisory) stays a warning, as in the audit settings above. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1859;CA1711;CA1716</NoWarn>
  </PropertyGroup>
</Project>
