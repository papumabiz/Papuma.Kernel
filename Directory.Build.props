<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <Authors>Harald Lapp</Authors>
    <Copyright>Copyright © 2026 Harald Lapp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/papumabiz/Papuma.Kernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/papumabiz/Papuma.Kernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <!-- Source Link: the SDK resolves the GitHub provider automatically; these make the
       published packages debuggable (step into the exact commit) and reproducible. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- XML documentation ships with the packages so consumers get IntelliSense.
       CS1591 (missing comment on a public member) stays off: the public surface is
       documented, but internals promoted to public for testing are not, and a wall of
       CS1591 would drown real warnings. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
