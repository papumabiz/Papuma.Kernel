<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The JSON generator and the session model runner are shared with Papuma.Kernel.Core.Tests, which owns them. -->
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\JsonGenerator.cs" Link="Robustness\JsonGenerator.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\SessionModelRunner.cs" Link="Robustness\SessionModelRunner.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\ConcurrencyRunner.cs" Link="Robustness\ConcurrencyRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit, not transitive: Papuma.Kernel.Local references Core with
         PrivateAssets="all", which cuts transitive compile-time visibility. -->
    <ProjectReference Include="..\..\src\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Local\Papuma.Kernel.Local.csproj" />
  </ItemGroup>

</Project>
