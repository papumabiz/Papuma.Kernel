<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The AspNetCore layer tests (middleware, dashboard) need the ASP.NET types directly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit, not transitive: Papuma.Kernel references Core with PrivateAssets="all",
         which cuts transitive compile-time visibility. Tests reach Core internals directly
         (KernelModel, PolicyHash.Of(...)), so they need their own reference. -->
    <ProjectReference Include="..\..\src\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel\Papuma.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.AspNetCore\Papuma.Kernel.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Mcp\Papuma.Kernel.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Testing\Papuma.Kernel.Testing.csproj" />
  </ItemGroup>

</Project>
