<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The AspNetCore layer tests (middleware, dashboard) need the ASP.NET types directly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The patch vector loader and the JSON generator are shared with Papuma.Kernel.Core.Tests, which owns them. -->
    <Compile Include="..\Papuma.Kernel.Core.Tests\Spec\PatchVectors.cs" Link="Spec\PatchVectors.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\JsonGenerator.cs" Link="Robustness\JsonGenerator.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Changes\DiffComparison.cs" Link="Changes\DiffComparison.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\SessionModelRunner.cs" Link="Robustness\SessionModelRunner.cs" />
    <Compile Include="..\Papuma.Kernel.Core.Tests\Robustness\ConcurrencyRunner.cs" Link="Robustness\ConcurrencyRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit, not transitive: Papuma.Kernel references Core with PrivateAssets="all",
         which cuts transitive compile-time visibility. Tests reach Core internals directly
         (KernelModel, PolicyHash.Of(...)), so they need their own reference. -->
    <ProjectReference Include="..\..\src\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel\Papuma.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.AspNetCore\Papuma.Kernel.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Mcp\Papuma.Kernel.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Testing\Papuma.Kernel.Testing.csproj" />
  </ItemGroup>

</Project>
