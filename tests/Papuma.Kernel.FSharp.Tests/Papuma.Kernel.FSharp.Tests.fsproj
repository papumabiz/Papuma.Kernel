<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Infrastructure.fs" />
    <Compile Include="PatchTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="KeyTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite-only, on the public AddPapumaKernelLocal bootstrap — no need for the
         Postgres kernel or Docker (mirrors why Papuma.Kernel.Local.Tests needs nothing
         extra). No InternalsVisibleTo into this project, so tests go through public API
         only, same as a real consumer would. -->
    <ProjectReference Include="..\..\src\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.Local\Papuma.Kernel.Local.csproj" />
    <ProjectReference Include="..\..\src\Papuma.Kernel.FSharp\Papuma.Kernel.FSharp.fsproj" />
  </ItemGroup>

</Project>
