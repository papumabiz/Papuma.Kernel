{
  "spec": "papuma-changes",
  "version": "0.1",
  "kind": "policy",
  "description": "Policy vectors: applying 'policies' to 'diff' for document 'documentType'/'documentId' must yield 'expected' (wire format). Policies not listed default to Track. A case with 'hashKey' (masterKeyHex, kid) and 'tenantId' runs with the keyed v2 hash provider (ADR-025). A Hash policy that applies without a key must fail ('error': 'no-hash-key'): there is no unkeyed hash.",
  "cases": [
    {
      "name": "no-policies-leave-the-diff-untouched",
      "documentType": "User",
      "documentId": "123",
      "policies": {},
      "diff": { "name": { "old": "a", "new": "b" } },
      "expected": { "name": { "old": "a", "new": "b" } }
    },
    {
      "name": "redact-withholds-values",
      "documentType": "User",
      "documentId": "123",
      "policies": { "iban": "Redact" },
      "diff": {
        "iban": { "old": "DE01", "new": "DE02" },
        "name": { "old": "a", "new": "b" }
      },
      "expected": {
        "iban": { "changed": true },
        "name": { "old": "a", "new": "b" }
      }
    },
    {
      "name": "redact-covers-added-and-removed-fields",
      "documentType": "User",
      "documentId": "123",
      "policies": { "iban": "Redact", "phone": "Redact" },
      "diff": {
        "iban": { "new": "DE02" },
        "phone": { "old": "0228" }
      },
      "expected": {
        "iban": { "changed": true },
        "phone": { "changed": true }
      }
    },
    {
      "name": "ancestor-policy-covers-a-key-with-a-dot",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "settings": "Redact"
      },
      "diff": {
        "settings.feature\\.enabled": {
          "new": true
        },
        "other": {
          "new": 1
        }
      },
      "expected": {
        "settings.feature\\.enabled": {
          "changed": true
        },
        "other": {
          "new": 1
        }
      }
    },
    {
      "name": "policy-on-an-escaped-path-does-not-cover-the-nested-path",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "a\\.b": "Redact"
      },
      "diff": {
        "a.b": {
          "new": 1
        },
        "a\\.b": {
          "new": 2
        }
      },
      "expected": {
        "a.b": {
          "new": 1
        },
        "a\\.b": {
          "changed": true
        }
      }
    },
    {
      "name": "nearest-declared-path-wins-with-a-dotted-key",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "m": "Redact",
        "m.x\\.y": "Track"
      },
      "diff": {
        "m.x\\.y": {
          "new": 1
        },
        "m.z": {
          "new": 2
        }
      },
      "expected": {
        "m.x\\.y": {
          "new": 1
        },
        "m.z": {
          "changed": true
        }
      }
    },
    {
      "name": "reference-points-at-type-id-and-path",
      "documentType": "User",
      "documentId": "123",
      "policies": { "ssn": "Reference" },
      "diff": { "ssn": { "old": "1", "new": "2" } },
      "expected": { "ssn": { "ref": "User/123/ssn" } }
    },
    {
      "name": "do-not-track-drops-the-entry",
      "documentType": "User",
      "documentId": "123",
      "policies": { "lastSeen": "DoNotTrack" },
      "diff": {
        "lastSeen": { "old": "t1", "new": "t2" },
        "name": { "old": "a", "new": "b" }
      },
      "expected": { "name": { "old": "a", "new": "b" } }
    },
    {
      "name": "do-not-track-can-empty-the-diff",
      "documentType": "User",
      "documentId": "123",
      "policies": { "lastSeen": "DoNotTrack" },
      "diff": { "lastSeen": { "old": "t1", "new": "t2" } },
      "expected": {}
    },
    {
      "name": "ancestor-policy-covers-descendants",
      "documentType": "User",
      "documentId": "123",
      "policies": { "address": "Redact" },
      "diff": {
        "address.city": { "old": "Bonn", "new": "Köln" },
        "address.zip": { "old": "1", "new": "2" }
      },
      "expected": {
        "address.city": { "changed": true },
        "address.zip": { "changed": true }
      }
    },
    {
      "name": "nested-policy-splits-an-insert",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address.street": "Redact"
      },
      "diff": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        },
        "name": {
          "new": "Harry"
        }
      },
      "expected": {
        "address": {
          "new": {
            "city": "Bonn"
          }
        },
        "address.street": {
          "changed": true
        },
        "name": {
          "new": "Harry"
        }
      }
    },
    {
      "name": "nested-policy-splits-a-delete",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address.street": "Redact"
      },
      "diff": {
        "address": {
          "old": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "old": {
            "city": "Bonn"
          }
        },
        "address.street": {
          "changed": true
        }
      }
    },
    {
      "name": "nested-policy-splits-a-type-change",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address.street": "Redact"
      },
      "diff": {
        "address": {
          "old": null,
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "old": null,
          "new": {
            "city": "Bonn"
          }
        },
        "address.street": {
          "changed": true
        }
      }
    },
    {
      "name": "nested-policy-splits-deep-and-keeps-the-rest",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "a.b.c": "Redact"
      },
      "diff": {
        "a": {
          "new": {
            "b": {
              "c": "secret",
              "d": 1
            },
            "e": 2
          }
        }
      },
      "expected": {
        "a": {
          "new": {
            "b": {
              "d": 1
            },
            "e": 2
          }
        },
        "a.b.c": {
          "changed": true
        }
      }
    },
    {
      "name": "nested-do-not-track-leaves-only-the-container",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address.street": "DoNotTrack"
      },
      "diff": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "new": {
            "city": "Bonn"
          }
        }
      }
    },
    {
      "name": "nested-reference-names-the-split-path",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address.street": "Reference"
      },
      "diff": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "new": {
            "city": "Bonn"
          }
        },
        "address.street": {
          "ref": "User/123/address.street"
        }
      }
    },
    {
      "name": "nearest-declared-path-wins-inside-a-split-container",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "address": "Redact",
        "address.city": "Track"
      },
      "diff": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "changed": true
        },
        "address.city": {
          "new": "Bonn"
        }
      }
    },
    {
      "name": "no-policy-below-means-no-split",
      "documentType": "User",
      "documentId": "123",
      "policies": {
        "email": "Redact"
      },
      "diff": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      },
      "expected": {
        "address": {
          "new": {
            "street": "Main St 1",
            "city": "Bonn"
          }
        }
      }
    },
    {
      "name": "nearest-declared-path-wins",
      "documentType": "User",
      "documentId": "123",
      "policies": { "address": "Redact", "address.city": "Track" },
      "diff": {
        "address.city": { "old": "Bonn", "new": "Köln" },
        "address.zip": { "old": "1", "new": "2" }
      },
      "expected": {
        "address.city": { "old": "Bonn", "new": "Köln" },
        "address.zip": { "changed": true }
      }
    },
    {
      "name": "reference-on-ancestor-yields-one-ref-per-descendant-path",
      "documentType": "User",
      "documentId": "123",
      "policies": { "address": "Reference" },
      "diff": { "address.city": { "old": "Bonn", "new": "Köln" } },
      "expected": { "address.city": { "ref": "User/123/address.city" } }
    },
    {
      "name": "hash-of-a-removed-field-has-no-hash",
      "documentType": "User",
      "documentId": "123",
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a" } },
      "expected": { "pw": { "changed": true } }
    },
    {
      "name": "hash-without-a-key-fails",
      "documentType": "User",
      "documentId": "123",
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a", "new": "b" } },
      "error": "no-hash-key"
    },
    {
      "name": "hash-v2-of-a-string-value",
      "documentType": "User",
      "documentId": "123",
      "tenantId": "acme",
      "hashKey": { "masterKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "kid": "test" },
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a", "new": "b" } },
      "expected": {
        "pw": {
          "changed": true,
          "hash": "v2:test:ad8524f83712ab5c9ea5154f89e0fd1f5067969a609f8f9cc0430ce6e05c532d"
        }
      }
    },
    {
      "name": "hash-v2-hashes-numbers-by-value",
      "documentType": "User",
      "documentId": "123",
      "tenantId": "acme",
      "hashKey": { "masterKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "kid": "test" },
      "policies": { "pin": "Hash" },
      "diff": { "pin": { "old": 1, "new": 42.0 } },
      "expected": {
        "pin": {
          "changed": true,
          "hash": "v2:test:892a8d034a76fe06701b13e50410d81ae47c69e1e9401d7d4a81e84e88b12583"
        }
      }
    },
    {
      "name": "hash-v2-differs-per-tenant",
      "documentType": "User",
      "documentId": "123",
      "tenantId": "globex",
      "hashKey": { "masterKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "kid": "test" },
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a", "new": "b" } },
      "expected": {
        "pw": {
          "changed": true,
          "hash": "v2:test:fec23d6a3f337661b5d7a63b158943db5c0edf5e2c7d9470224101a61963be8a"
        }
      }
    },
    {
      "name": "hash-v2-in-platform-scope",
      "documentType": "User",
      "documentId": "123",
      "tenantId": "",
      "hashKey": { "masterKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "kid": "test" },
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a", "new": "b" } },
      "expected": {
        "pw": {
          "changed": true,
          "hash": "v2:test:dbc7a6b5b1f5d311214408c0a6538abdf505d5eba9f27813e51bc614275dbad6"
        }
      }
    },
    {
      "name": "hash-v2-of-a-removed-field-has-no-hash",
      "documentType": "User",
      "documentId": "123",
      "tenantId": "acme",
      "hashKey": { "masterKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "kid": "test" },
      "policies": { "pw": "Hash" },
      "diff": { "pw": { "old": "a" } },
      "expected": { "pw": { "changed": true } }
    }
  ]
}
