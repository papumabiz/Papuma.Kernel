# Papuma.Kernel Sample — diagnostics and the MCP endpoint via httpYAC.
#
# The MCP section uses the Streamable-HTTP protocol: initialize → (session id
# from the Mcp-Session-Id response header, captured by the script block) →
# tools. Responses arrive as text/event-stream — httpYAC displays them fine.

### Health (includes the change-feed lag check)
GET {{host}}/health

### ─────────────────────────────────────────────────────────────────────────────
### MCP handshake (observability.md: the diagnostics surface for AI agents)

### MCP 1: initialize — note the Mcp-Session-Id response header
# @name mcpInit
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": { "name": "httpyac", "version": "1.0" }
  }
}

{{
  exports.mcpSession = response.headers['mcp-session-id'];
}}

### MCP 2: initialized notification (completes the handshake)
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "method": "notifications/initialized"
}

### MCP 3: list the Papuma tools
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list"
}

### MCP 4: feed lag per handler (both feeds)
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "get_feed_lag",
    "arguments": {}
  }
}

### MCP 5: the Art.-30 model inventory (types, policies, keys, retentions)
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "get_model_inventory",
    "arguments": {}
  }
}

### MCP 6: a document history, scope-bound and policy-applied
# Paste an order id from shop.http here:
@orderId = paste-an-order-id-here
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "get_document_history",
    "arguments": {
      "documentType": "Order",
      "documentId": "{{orderId}}",
      "tenantId": "demo"
    }
  }
}

### MCP 7: failure table of both feeds (poison candidates)
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{mcpSession}}

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/call",
  "params": {
    "name": "get_feed_failures",
    "arguments": {}
  }
}
