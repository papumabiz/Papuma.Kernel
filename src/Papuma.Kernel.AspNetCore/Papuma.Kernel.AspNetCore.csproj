<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Papuma.Kernel.AspNetCore</PackageId>
    <Description>Optional ASP.NET Core integration for Papuma.Kernel — tenant scope resolution middleware, change feed lag health checks, and an embedded first-look dashboard (lag, failures, throughput).</Description>
    <PackageTags>aspnetcore;multi-tenancy;health-checks;change-feed;dashboard</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Papuma.Kernel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Papuma.Kernel\Papuma.Kernel.csproj" />
    <!-- Compiles directly against Core types (e.g. ScopeContext); PrivateAssets suppresses a
         phantom nuspec dependency on the unpublished Papuma.Kernel.Core — Core.dll already
         reaches consumers transitively via the Papuma.Kernel package dependency above. -->
    <ProjectReference Include="..\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
