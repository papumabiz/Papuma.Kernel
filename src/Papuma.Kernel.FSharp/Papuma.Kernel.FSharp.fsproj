<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Papuma.Kernel.FSharp</PackageId>
    <Description>F#-idiomatic facade over Papuma Kernel's write path: quotation-based Patch (SetQ/RemoveQ/IncrementQ — no Expression&lt;Func&lt;T,TValue&gt;&gt; ceremony), Result&lt;T,KernelError&gt; instead of exceptions for the three expected write outcomes (ADR-003/ADR-006), and an IAsyncDisposable-safe session runner. Works with either kernel — reference Papuma.Kernel (PostgreSQL) or Papuma.Kernel.Local (SQLite) alongside this package.</Description>
    <PackageTags>fsharp;documents;cqrs;patch;quotations;result</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Agent-readable documentation ships with the package, same rationale as
       Papuma.Kernel.csproj/Papuma.Kernel.Local.csproj: after restore it's on disk in the
       consumer's global packages folder, so a coding agent working in an F# app can read
       the F#-specific guidance locally. A consumer of this package always also references
       Papuma.Kernel or Papuma.Kernel.Local (this package only extends Papuma.Kernel.Core's
       PatchBuilder<T>), which already bundle the full doc set — these are the same files,
       duplicated here so they're found without having to know to look in the other
       package's folder. -->
  <ItemGroup>
    <None Include="..\..\docs\ai\papuma-kernel-playbook.md" Pack="true" PackagePath="docs\ai\" />
    <None Include="..\..\docs\ai\papuma-kernel-agents-snippet.md" Pack="true" PackagePath="docs\ai\" />
    <None Include="..\..\docs\ai\papuma-kernel-slice-conventions.md" Pack="true" PackagePath="docs\ai\" />
    <None Include="..\..\docs\concepts.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Errors.fs" />
    <Compile Include="Quotations.fs" />
    <Compile Include="Patch.fs" />
    <Compile Include="Session.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- PatchBuilder<T> (the type being extended) lives in Papuma.Kernel.Core, shared by
         both kernels — referencing Core directly (not Papuma.Kernel or .Local) keeps this
         package usable with either. Same embedding pattern as Papuma.Kernel.csproj /
         Papuma.Kernel.Local.csproj: Core is not independently published
         (IsPackable=false in its own csproj), so its assembly must be copied into this
         package explicitly — the target below does that. -->
    <ProjectReference Include="..\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>
