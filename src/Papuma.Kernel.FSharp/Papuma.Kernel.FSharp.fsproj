<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prototype (not yet a packaged product) — validates whether Papuma's
       Expression<Func<T,TValue>>-based Patch API can be made F#-idiomatic without
       touching Papuma.Kernel.Core. See Patch.fs for the rationale and the empirically
       verified quotation-to-Expression conversion it relies on. IsPackable stays false
       until that's confirmed to feel right in real use. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Errors.fs" />
    <Compile Include="Quotations.fs" />
    <Compile Include="Patch.fs" />
    <Compile Include="Session.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- PatchBuilder<T> (the type being extended) lives in Papuma.Kernel.Core, shared by
         both kernels — referencing Core directly (not Papuma.Kernel or .Local) keeps this
         extension usable from either. -->
    <ProjectReference Include="..\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
  </ItemGroup>

</Project>
