<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Papuma.Kernel.FSharp</PackageId>
    <Description>F#-idiomatic facade over Papuma Kernel's write path: Result&lt;T,KernelError&gt; instead of exceptions for the three expected write outcomes (ADR-003/ADR-006), and an IAsyncDisposable-safe session runner. Works with either kernel — reference Papuma.Kernel (PostgreSQL) or Papuma.Kernel.Local (SQLite) alongside this package.</Description>
    <PackageTags>fsharp;documents;cqrs;patch;quotations;result</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Errors.fs" />
    <Compile Include="Quotations.fs" />
    <Compile Include="Patch.fs" />
    <Compile Include="Session.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central Package Management turns off the SDK's implicit FSharp.Core reference, so it
         is explicit; its version in Directory.Packages.props is the floor consumers get. -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- PatchBuilder<T> (the type being extended) lives in Papuma.Kernel.Core, shared by
         both kernels — depending on Core (not Papuma.Kernel or .Local) keeps this package
         usable with either, and the exact-version dependency keeps it on the kernel's build. -->
    <ProjectReference Include="..\Papuma.Kernel.Core\Papuma.Kernel.Core.csproj" />
  </ItemGroup>

</Project>
